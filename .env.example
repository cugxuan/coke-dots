# Server reads these from its environment. Do not commit actual credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4317/auth/google/callback
# Optional single-user access-key login, without Google.
# Generate a secret with openssl rand -hex 32; keep the environment file private.
# DOTS_AUTH_MODE=local
# DOTS_LOCAL_AUTH_TOKEN=<32-256 random ASCII characters>
# Google remains the default. Public key login requires HTTPS and a trusted proxy.
# Optional LAN access. Set the actual private server IP and permitted client subnet.
# The default listener stays 127.0.0.1; Docker/SSH desktop ports stay private.
# DOTS_BIND_HOST=0.0.0.0
# DOTS_LAN_ORIGIN=http://192.168.1.10:4317
# DOTS_LAN_CIDR=192.168.1.0/24
# Optional HTTPS domain through a proxy/tunnel connecting from loopback.
# DOTS_PUBLIC_ORIGIN=https://dots.example.com
# Default mode is token: the proxy must overwrite X-Dots-Proxy-Token.
# DOTS_TRUSTED_PROXY_TOKEN=<32-256 random ASCII characters>
# For a trusted local tunnel (e.g. FRP TCP) that cannot inject a token:
# DOTS_TRUSTED_PROXY_MODE=loopback
# This mode requires exact public Host and X-Forwarded-Proto: https from loopback.
# For a reverse-proxy subpath, keep these paths aligned with the public callback.
# DOTS_BASE_PATH=/dots-demo
# DOTS_APP_URL=https://codex.example.com/dots-demo
# GOOGLE_REDIRECT_URI=https://codex.example.com/dots-demo/auth/google/callback

# Optional Slack OAuth v2 app. Use the public HTTPS callback in production.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://127.0.0.1:4317/auth/slack/callback

# Instance-wide model metadata; configure the API key in the signed-in settings UI.
# Normal operation uses Kubernetes Secret storage, or the file store below.
# DOTS_MODEL_API_KEY is accepted only by the isolated E2E test fixture.
DOTS_MODEL_BASE_URL=https://api.openai.com/v1
DOTS_MODEL=your-chat-completions-model
DOTS_MODEL_API_KEY=
DOTS_DATA_DIR=./data

# Optional low-latency Qwen speech-to-speech calls. The voice key is shared by
# the running Coke Dots instance and is never sent to a browser or tenant.
DOTS_VOICE_PROVIDER=browser
DOTS_QWEN_API_KEY=
DOTS_QWEN_WORKSPACE_ID=
DOTS_QWEN_REGION=beijing
DOTS_QWEN_MODEL=qwen3.8-omni-flash-realtime
# Token Plan: use workspace token-plan and model qwen-audio-3.0-realtime-plus.

# Optional Volcano Engine SeedDuplex 3.0 real-time voice. The API Key is an
# instance-wide server secret, never sent to browsers or tenant workspaces.
# When present, it selects the JSON SeedDuplex protocol ahead of legacy O2.0.
DOTS_VOLCENGINE_API_KEY=
# Legacy O2.0 fallback only; requires both values and uses the binary protocol.
DOTS_VOLCENGINE_APP_ID=
DOTS_VOLCENGINE_ACCESS_TOKEN=
DOTS_VOLCENGINE_RESOURCE_ID=volc.speech.dialog

# Optional Agent kernels.
DOTS_PI_ENABLED=0
DOTS_DSH_BIN=
DOTS_DSH_READ_ONLY_CONFIG=

# Optional Debian single-host mode. Existing Kubernetes mode stays linux-desktop.
# DOTS_COMPUTER_BACKEND=ssh-docker
# DOTS_DOCKER_SSH_HOST=dots-debian
# SSH port/identity/known_hosts are read from ~/.ssh/config unless overridden.
# DOTS_DOCKER_SSH_PORT=22
# DOTS_DOCKER_SSH_IDENTITY_FILE=/absolute/path/to/private-key
# DOTS_DOCKER_SSH_KNOWN_HOSTS_FILE=/absolute/path/to/known_hosts
# Choose a stable, unique instance ID when sharing a Docker host.
# DOTS_DOCKER_INSTANCE_ID=coke-dots
# DOTS_LINUX_DESKTOP_TOKEN_SECRET=<random secret of at least 32 characters>
# DOTS_LINUX_DESKTOP_IMAGE=coke-dots-linux-desktop:sha-<40-character-git-revision>
# DOTS_DOCKER_CPUS=2
# DOTS_DOCKER_MEMORY_MB=4096
# DOTS_PI_ENABLED=1

# Defaults to file in ssh-docker mode, kubernetes in all existing modes.
# Changing the backend does not copy credentials; save the key again in settings.
# DOTS_MODEL_SECRET_BACKEND=file
# Default: DOTS_DATA_DIR/secrets/model-api-key, on the control-plane machine.
# DOTS_MODEL_SECRET_FILE=/absolute/path/to/private-directory/model-api-key
